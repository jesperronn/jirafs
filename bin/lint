#!/usr/bin/env bash

set -euo pipefail

# Usage: bin/lint [--help] [--verbose] [--autofix] [PATH...]
#
#   --help      Print usage to stdout and exit.
#   --verbose   Print each check name as it runs.
#   --autofix   Run gofmt -w on unformatted Go files in the linted scope.
#   PATH...     Any number of files or directories. Go files and directories
#               get gofmt -l and go vet (skipping the slower whole-repo
#               docs/lint checks). Other files are skipped with a note.
#               No PATH: gofmt over the whole repo, then tools/lint_repo.py.

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [PATH...]

Options:
  --help      Show this help message and exit.
  --verbose   Print each check name as it runs.
  --autofix   Rewrite unformatted Go files with gofmt -w instead of failing.

Positional:
  PATH...     Any number of files or directories. Go files and directories
              are checked with gofmt and go vet; non-Go files are skipped
              with a note. Exits non-zero if any path fails. When omitted,
              runs gofmt over the whole repo, then the whole-repo lint
              suite (tools/lint_repo.py).
EOF
    exit 0
}

VERBOSE=0
AUTOFIX=0
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            ;;
        --verbose|-v)
            VERBOSE=1
            ;;
        --autofix)
            AUTOFIX=1
            ;;
        --)
            shift
            POSITIONAL+=("$@")
            break
            ;;
        -*)
            echo "error: unknown argument: $1" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            ;;
    esac
    shift
done

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

export PYTHONPATH="${REPO_ROOT}"

log() {
    if [ "${VERBOSE}" -eq 1 ]; then
        printf "lint: %s\n" "$*" >&2
    fi
}

# check_gofmt SCOPE...
# Fails (listing files) if gofmt -l reports unformatted Go files in SCOPE.
# With --autofix, rewrites them with gofmt -w instead.
check_gofmt() {
    log "gofmt -l $*"
    local fmt_out
    fmt_out="$(gofmt -l "$@" || true)"
    if [ -z "${fmt_out}" ]; then
        return 0
    fi
    if [ "${AUTOFIX}" -eq 1 ]; then
        log "gofmt -w (autofix)"
        echo "${fmt_out}" | while IFS= read -r f; do
            gofmt -w "$f"
            echo "gofmt: fixed ${f}" >&2
        done
        return 0
    fi
    echo "gofmt: files need formatting (run bin/lint --autofix to fix):" >&2
    echo "${fmt_out}" | sed 's/^/  /' >&2
    exit 1
}

if [ "${#POSITIONAL[@]}" -gt 0 ]; then
    go_targets=()
    vet_patterns=()
    for target in "${POSITIONAL[@]}"; do
        if [ -d "${target}" ]; then
            scope_dir="${target}"
            go_targets+=("${target}")
        elif [ -f "${target}" ]; then
            case "${target}" in
                *.go)
                    scope_dir="$(dirname "${target}")"
                    go_targets+=("${target}")
                    ;;
                *)
                    echo "lint: skipping ${target} (not a Go file; no check applies)" >&2
                    continue
                    ;;
            esac
        else
            echo "error: ${target} is neither a file nor a directory" >&2
            exit 1
        fi
        scope_dir="${scope_dir#./}"
        pattern="./${scope_dir}/..."
        if [ "${scope_dir}" = "." ]; then
            pattern="./..."
        fi
        case " ${vet_patterns[*]:-} " in
            *" ${pattern} "*) ;;
            *) vet_patterns+=("${pattern}") ;;
        esac
    done

    if [ "${#go_targets[@]}" -gt 0 ]; then
        check_gofmt "${go_targets[@]}"
        log "go vet ${vet_patterns[*]}"
        go vet "${vet_patterns[@]}"
    fi

    echo "lint: ok (${POSITIONAL[*]})"
    exit 0
fi

# Whole-repo lint.
log "gofmt over whole repo"
check_gofmt .

log "tools/lint_repo.py"
python3 tools/lint_repo.py
