#!/usr/bin/env bash

set -euo pipefail

# Usage: bin/lint [--help] [--verbose] [--autofix] [PATH]
#
#   --help      Print usage and exit.
#   --verbose   Print each check name as it runs.
#   --autofix   Run `gofmt -w` on unformatted Go files in the linted scope.
#   PATH        File or directory to scope go-toolchain linting to. When
#               given, only `gofmt -l` and `go vet` are run against that
#               scope (skipping the slower whole-repo docs/lint checks).
#               No PATH → gofmt over the whole repo, then tools/lint_repo.py.

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") [OPTIONS] [PATH]

Options:
  --help      Show this help message and exit.
  --verbose   Print each check name as it runs.
  --autofix   Rewrite unformatted Go files with `gofmt -w` instead of failing.

Positional:
  PATH        Scope go-toolchain linting (gofmt, go vet) to PATH. When
              omitted, runs gofmt over the whole repo, then the whole-repo
              lint suite (tools/lint_repo.py).
EOF
    exit 0
}

VERBOSE=0
AUTOFIX=0
POSITIONAL=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            ;;
        --verbose|-v)
            VERBOSE=1
            ;;
        --autofix)
            AUTOFIX=1
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "error: unknown argument: $1" >&2
            exit 1
            ;;
        *)
            if [ -n "${POSITIONAL}" ]; then
                echo "error: only one PATH argument is allowed" >&2
                exit 1
            fi
            POSITIONAL="$1"
            ;;
    esac
    shift
done

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

export PYTHONPATH="${REPO_ROOT}"

log() {
    if [ "${VERBOSE}" -eq 1 ]; then
        printf "lint: %s\n" "$*" >&2
    fi
}

# check_gofmt SCOPE...
# Fails (listing files) if gofmt -l reports unformatted Go files in SCOPE.
# With --autofix, rewrites them with gofmt -w instead.
check_gofmt() {
    log "gofmt -l $*"
    local fmt_out
    fmt_out="$(gofmt -l "$@" || true)"
    if [ -z "${fmt_out}" ]; then
        return 0
    fi
    if [ "${AUTOFIX}" -eq 1 ]; then
        log "gofmt -w (autofix)"
        echo "${fmt_out}" | while IFS= read -r f; do
            gofmt -w "$f"
            echo "gofmt: fixed ${f}" >&2
        done
        return 0
    fi
    echo "gofmt: files need formatting (run bin/lint --autofix to fix):" >&2
    echo "${fmt_out}" | sed 's/^/  /' >&2
    exit 1
}

if [ -n "${POSITIONAL}" ]; then
    target="${POSITIONAL}"
    if [ -f "${target}" ]; then
        scope_dir="$(dirname "${target}")"
        scope_files=("${target}")
    elif [ -d "${target}" ]; then
        scope_dir="${target}"
        # gofmt + go vet can both take a directory pattern.
        scope_files=("${target}")
    else
        echo "error: ${POSITIONAL} is neither a file nor a directory" >&2
        exit 1
    fi
    scope_dir="${scope_dir#./}"
    pkg_pattern="./${scope_dir}/..."

    check_gofmt "${scope_files[@]}"

    log "go vet ${pkg_pattern}"
    go vet "${pkg_pattern}"

    echo "lint: ok (${POSITIONAL})"
    exit 0
fi

# Whole-repo lint.
log "gofmt over whole repo"
check_gofmt .

log "tools/lint_repo.py"
python3 tools/lint_repo.py
