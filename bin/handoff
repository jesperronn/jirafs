#!/usr/bin/env bash

set -euo pipefail

# Prepare the current branch for integration: rebase it onto `main` and run
# bin/verify. This script NEVER merges, fast-forwards, or updates the main
# ref; merging is done by the user or orchestrator.
#
# Final line is the status signal:
#   clean: nothing ahead of main
#   done: rebased onto main at <sha>, verified; ready to merge: <command>
#   blocked: <reason>   (rebase aborted, worktree left clean)

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "blocked: worktree has uncommitted changes"
  exit 1
fi

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [ -z "${branch}" ]; then
  echo "blocked: HEAD is detached"
  exit 1
fi
if [ "${branch}" = "main" ]; then
  echo "blocked: refusing to hand off main to itself"
  exit 1
fi

if [ "$(git rev-list --count main..HEAD)" = "0" ]; then
  echo "clean: nothing ahead of main"
  exit 0
fi

if ! git rebase main >/dev/null 2>&1; then
  git rebase --abort >/dev/null 2>&1 || true
  echo "blocked: rebase onto main conflicted; rebase aborted, tree clean. Resolve with: git rebase main"
  exit 1
fi

if ! bin/verify; then
  echo "blocked: bin/verify failed after rebase onto main; fix and re-run bin/handoff"
  exit 1
fi

sha="$(git rev-parse --short HEAD)"
echo "done: rebased onto main at ${sha}, verified; ready to merge: git merge --ff-only ${branch}"
